{
  "_note": "Sanitized snapshot of the live OpenClaw profile `confer-newsroom` (OpenClaw 2026.10.1). Generated by scripts/snapshot_agent_configs.py; see agents/SNAPSHOT.md.",
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "<stored in a separate mode-600 file; not included>"
    }
  },
  "tools": {
    "elevated": {
      "enabled": false
    },
    "exec": {
      "security": "deny"
    }
  },
  "browser": {
    "enabled": false
  },
  "agents": {
    "defaults": {
      "sandbox": {
        "mode": "all",
        "docker": {
          "readOnlyRoot": true,
          "network": "none",
          "memory": "2g",
          "cpus": 1,
          "pidsLimit": 128,
          "capDrop": [
            "ALL"
          ],
          "user": "1000:1000"
        }
      },
      "systemAgent": {
        "agentId": "main"
      },
      "heartbeat": {
        "agentId": "main"
      }
    },
    "ownership": "explicit",
    "entries": {
      "main": {
        "workspace": "~/.openclaw-confer-newsroom/workspace"
      },
      "builder": {
        "name": "builder",
        "description": "builder: implements one ticket per pull request, edits only app/",
        "workspace": "~/newsroom-work/builder",
        "model": {
          "primary": "ollama-cloud/gpt-oss:120b",
          "fallbacks": [
            "ollama-cloud/nemotron-3-super",
            "openrouter/poolside/laguna-s-2.1:free",
            "ollama/qwen2.5:7b"
          ]
        },
        "sandbox": {
          "workspaceAccess": "rw",
          "scope": "agent"
        },
        "tools": {
          "profile": "coding"
        },
        "identity": {
          "name": "builder"
        }
      },
      "tester": {
        "name": "tester",
        "description": "tester: writes independent acceptance tests from the ticket; the harness runs them in an offline container",
        "workspace": "~/newsroom-work/tester",
        "model": {
          "primary": "ollama-cloud/gpt-oss:20b",
          "fallbacks": [
            "ollama-cloud/nemotron-3-nano:30b",
            "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
            "ollama/qwen2.5:7b"
          ]
        },
        "sandbox": {
          "workspaceAccess": "rw",
          "scope": "agent"
        },
        "tools": {
          "profile": "coding"
        },
        "identity": {
          "name": "tester"
        }
      }
    }
  },
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434",
        "api": "ollama",
        "apiKey": "<placeholder: the local Ollama provider takes no key; cloud keys come from the environment>",
        "models": [
          {
            "id": "qwen2.5-coder:7b",
            "name": "Qwen 2.5 Coder 7B",
            "contextWindow": 32768,
            "maxTokens": 4096,
            "reasoning": false,
            "input": [
              "text"
            ]
          },
          {
            "id": "qwen2.5:7b",
            "name": "Qwen 2.5 7B Instruct",
            "contextWindow": 32768,
            "maxTokens": 4096,
            "reasoning": false,
            "input": [
              "text"
            ]
          },
          {
            "id": "llama3.1:8b",
            "name": "Llama 3.1 8B",
            "contextWindow": 65536,
            "maxTokens": 4096,
            "reasoning": false,
            "input": [
              "text"
            ]
          }
        ]
      }
    }
  },
  "model_provider_for_cloud_models": "ollama-cloud (built in; OLLAMA_API_KEY is read from the gateway's environment)",
  "plugins": {
    "entries": {
      "anthropic": {
        "config": {
          "sessionCatalog": {
            "enabled": false
          }
        }
      },
      "codex": {
        "config": {
          "sessionCatalog": {
            "enabled": false
          }
        }
      }
    }
  },
  "skills": "none written; OpenClaw's bundled plugin skills (e.g. browser-automation) are unused because the browser is disabled"
}
